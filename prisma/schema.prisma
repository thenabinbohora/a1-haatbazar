generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum ImageFormat {
  JPG
  JPEG
  PNG
  WEBP
}

enum AddressType {
  SHIPPING
  BILLING
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum CouponType {
  PERCENT
  FIXED_AMOUNT
}

enum BannerPlacement {
  HOME_HERO
  HOME_STRIP
  CATEGORY_TOP
}

enum InventoryChangeType {
  ADJUSTMENT
  SALE
  RETURN
  RESTOCK
  RESERVATION
  RELEASE
}

enum InventoryReason {
  SEED
  MANUAL_ADMIN
  ORDER_CREATED
  ORDER_CANCELLED
  SUPPLIER_RESTOCK
  DAMAGE
  CORRECTION
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  phone         String?
  role          UserRole       @default(CUSTOMER)
  status        UserStatus     @default(ACTIVE)
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  carts         Cart[]
  wishlist      Wishlist[]
  orders        Order[]
  inventoryLogs InventoryLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  isFeatured  Boolean    @default(false)
  sortOrder   Int        @default(0)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([isFeatured, sortOrder])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  country     String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  ingredients    String?
  storage        String?
  origin         String?
  allergens      String?
  regionTags     String[]         @default([])
  dietaryTags    String[]         @default([])
  tags           String[]         @default([])
  seoTitle       String?
  seoDescription String?
  status         ProductStatus    @default(DRAFT)
  isFeatured     Boolean          @default(false)
  isBestSeller   Boolean          @default(false)
  isWeeklyOffer  Boolean          @default(false)
  categoryId     String
  brandId        String?
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  images         ProductImage[]
  orderItems     OrderItem[]
  wishlist       Wishlist[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status, isFeatured])
}

model ProductVariant {
  id                String         @id @default(cuid())
  productId         String
  name              String
  sku               String         @unique
  barcode           String?        @unique
  sizeValue         Decimal?       @db.Decimal(10, 2)
  sizeUnit          String?
  packSize          Int?
  price             Decimal        @db.Decimal(10, 2)
  salePrice         Decimal?       @db.Decimal(10, 2)
  currency          String         @default("AUD")
  stock             Int            @default(0)
  lowStockThreshold Int            @default(5)
  imageUrl          String?
  status            VariantStatus  @default(ACTIVE)
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  inventoryLogs     InventoryLog[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([productId])
  @@index([status, stock])
}

model ProductImage {
  id          String      @id @default(cuid())
  productId   String
  variantId   String?
  url         String
  storagePath String
  altText     String
  format      ImageFormat
  sizeBytes   Int
  width       Int?
  height      Int?
  sortOrder   Int         @default(0)
  isPrimary   Boolean     @default(false)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([productId, sortOrder])
  @@index([variantId])
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(SHIPPING)
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  suburb     String
  state      String
  postalCode String
  country    String      @default("Australia")
  isDefault  Boolean     @default(false)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId, type])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?
  status    CartStatus @default(ACTIVE)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
  @@index([sessionId, status])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  addressId       String?
  couponId        String?
  status          OrderStatus     @default(PENDING)
  paymentStatus   PaymentStatus   @default(UNPAID)
  fulfillmentType FulfillmentType @default(DELIVERY)
  subtotal        Decimal         @db.Decimal(10, 2)
  discountTotal   Decimal         @default(0) @db.Decimal(10, 2)
  shippingTotal   Decimal         @default(0) @db.Decimal(10, 2)
  taxTotal        Decimal         @default(0) @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  currency        String          @default("AUD")
  customerEmail   String
  customerPhone   String?
  notes           String?
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  address         Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon          Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([couponId])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  productName String
  variantName String
  sku         String
  quantity    Int
  unitPrice   Decimal        @db.Decimal(10, 2)
  salePrice   Decimal?       @db.Decimal(10, 2)
  lineTotal   Decimal        @db.Decimal(10, 2)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  name            String
  type            CouponType
  value           Decimal    @db.Decimal(10, 2)
  minimumSubtotal Decimal?   @db.Decimal(10, 2)
  maxDiscount     Decimal?   @db.Decimal(10, 2)
  usageLimit      Int?
  usedCount       Int        @default(0)
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean    @default(true)
  orders          Order[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([code, isActive])
  @@index([expiresAt])
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  placement BannerPlacement
  sortOrder Int             @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

model InventoryLog {
  id             String              @id @default(cuid())
  variantId      String
  userId         String?
  changeType     InventoryChangeType
  reason         InventoryReason
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  note           String?
  variant        ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())

  @@index([variantId, createdAt])
  @@index([userId])
  @@index([changeType, reason])
}
